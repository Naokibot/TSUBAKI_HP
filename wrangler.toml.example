name = "tsubaki-portfolio"
compatibility_date = "2026-07-31"
pages_build_output_dir = "dist"

[vars]
ADMIN_EMAILS = "tsubaki.tech.jp@gmail.com"
GITHUB_REPOSITORY = "Naokibot/TSUBAKI_HP"
GITHUB_BRANCH = "main"
CONTACT_TO_EMAIL = "tsubaki.tech.jp@gmail.com"

# ADMIN_PASSWORD、SESSION_SECRET、GITHUB_TOKEN、RESEND_API_KEY、
# CONTACT_FROM_EMAIL、TURNSTILE_SECRETはCloudflare Secretsへ登録してください。

# 任意のKV bindings
# [[kv_namespaces]]
# binding = "CONTACT_RATE_LIMIT"
# id = "YOUR_KV_NAMESPACE_ID"
#
# [[kv_namespaces]]
# binding = "ADMIN_RATE_LIMIT"
# id = "YOUR_ADMIN_KV_NAMESPACE_ID"
