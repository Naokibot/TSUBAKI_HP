name = "tsubaki-portfolio"
compatibility_date = "2026-07-31"
pages_build_output_dir = "dist"

[vars]
GITHUB_REPOSITORY = "Naokibot/TSUBAKI_HP"
GITHUB_BRANCH = "main"
CONTACT_TO_EMAIL = "tsubaki.tech.jp@gmail.com"

# SESSION_SECRET、GITHUB_TOKEN、RESEND_API_KEY、
# ADMIN_FROM_EMAIL（またはCONTACT_FROM_EMAIL）、TURNSTILE_SECRETは
# Cloudflare Secretsへ登録してください。

# 管理者メールはソースコード内で次の2件だけに固定されています。
# - tomatonabe0120@gmail.com
# - tsubaki.tech.jp@gmail.com

# メール認証コード保存・送信回数制限に必須のKV binding
# [[kv_namespaces]]
# binding = "ADMIN_AUTH_KV"
# id = "YOUR_ADMIN_AUTH_KV_NAMESPACE_ID"

# 問い合わせフォームの任意KV binding
# [[kv_namespaces]]
# binding = "CONTACT_RATE_LIMIT"
# id = "YOUR_CONTACT_KV_NAMESPACE_ID"
